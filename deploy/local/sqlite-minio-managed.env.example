# 环境 ID；可复制为 deploy/local/sqlite-minio-managed.env，真实文件禁止提交。
SOULKING_DEPLOY_ENV_ID=local-sqlite-minio-managed
APP_ENV=development
APP_DEBUG=true

APP_NAME=Personal Music MVP
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

DATABASE_URL=sqlite:////data/music.db
DATABASE_TIMEZONE=Asia/Shanghai

S3_ENDPOINT_URL=http://soulking-minio:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_MUSIC=soulking
S3_PRESIGN_EXPIRE_SECONDS=900
S3_SECURE=false

IMPORT_ROOT=/import
DEFAULT_FORMAT_PRIORITY=flac,alac,m4a,aac,mp3,ogg,wav

HOST_PORT_APP=8000
HOST_PORT_MINIO_API=9000
HOST_PORT_MINIO_CONSOLE=9001
HOST_PORT_MINTLIFY_DOCS=3001
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINTLIFY_NODE_IMAGE=node:22-alpine
