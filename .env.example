APP_NAME=Personal Music MVP

# 首次空库启动时创建种子管理员（须满足密码复杂度）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
# Docker Compose：挂载 ./data:/data 时用下面（容器内路径）
DATABASE_URL=sqlite:////data/music.db
# 在 Mac/Windows 本机直接 uvicorn（不用 Docker）请改用项目下路径，例如：
# DATABASE_URL=sqlite:///./data/music.db
# SQLite 使用应用层北京时间写入；PostgreSQL/MySQL 会在连接时设为此 IANA 时区（或 MySQL 用 +08:00）
# DATABASE_TIMEZONE=Asia/Shanghai

# Docker 内访问宿主机上的 ProjectMinio（默认端口 9000）。本机直接 uvicorn 时用 http://127.0.0.1:9000
S3_ENDPOINT_URL=http://host.docker.internal:9000
# 浏览器加载头像等 presigned URL 的地址（须本机可访问）。Docker 跑应用、浏览器在宿主机访问时必填：
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_MUSIC=soulking
S3_PRESIGN_EXPIRE_SECONDS=900
S3_SECURE=false

IMPORT_ROOT=/import
DEFAULT_FORMAT_PRIORITY=flac,alac,m4a,aac,mp3,ogg,wav
