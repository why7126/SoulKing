# 环境 ID；复制为 deploy/prod/sqlite-minio-external.env 后替换真实值，真实文件禁止提交。
SOULKING_DEPLOY_ENV_ID=prod-sqlite-minio-external
APP_ENV=production
APP_DEBUG=false

APP_NAME=Personal Music MVP
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-production-admin-password

DATABASE_URL=sqlite:////data/music.db
DATABASE_TIMEZONE=Asia/Shanghai

S3_ENDPOINT_URL=https://replace-with-object-storage-endpoint
S3_PUBLIC_ENDPOINT_URL=https://replace-with-public-object-storage-endpoint
S3_ACCESS_KEY_ID=replace-with-object-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-object-storage-secret-key
S3_REGION_NAME=us-east-1
S3_BUCKET_MUSIC=soulking
S3_PRESIGN_EXPIRE_SECONDS=900
S3_SECURE=true

IMPORT_ROOT=/import
DEFAULT_FORMAT_PRIORITY=flac,alac,m4a,aac,mp3,ogg,wav

HOST_PORT_APP=8000
HOST_PORT_MINTLIFY_DOCS=3001
MINTLIFY_NODE_IMAGE=node:22-alpine
SOULKING_APP_IMAGE_REPOSITORY=soulking-app
SOULKING_IMAGE_TAG=v0.0.1
