APP_NAME=Personal Music MVP
# Docker Compose：挂载 ./data:/data 时用下面（容器内路径）
DATABASE_URL=sqlite:////data/music.db
# 在 Mac/Windows 本机直接 uvicorn（不用 Docker）请改用项目下路径，例如：
# DATABASE_URL=sqlite:///./data/music.db
# SQLite 使用应用层北京时间写入；PostgreSQL/MySQL 会在连接时设为此 IANA 时区（或 MySQL 用 +08:00）
# DATABASE_TIMEZONE=Asia/Shanghai

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_MUSIC=music-files
S3_BUCKET_COVERS=music-covers
S3_PRESIGN_EXPIRE_SECONDS=900
S3_SECURE=false

IMPORT_ROOT=/import
DEFAULT_FORMAT_PRIORITY=flac,alac,m4a,aac,mp3,ogg,wav

# Dify 工作流（后台「编辑歌曲」抽屉 — AI 解析）。示例：https://api.dify.ai/v1/workflows/run
# DIFY_WORKFLOW_API_URL=
# DIFY_WORKFLOW_API_KEY=
# 与工作流开始节点变量名一致时可改：
# DIFY_WORKFLOW_INPUT_TITLE=song_title
# DIFY_WORKFLOW_INPUT_LEAD_ARTIST=lead_artist
