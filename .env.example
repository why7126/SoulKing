APP_NAME=Personal Music MVP
DATABASE_URL=sqlite:////data/music.db

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_MUSIC=music-files
S3_BUCKET_COVERS=music-covers
S3_PRESIGN_EXPIRE_SECONDS=900
S3_SECURE=false

IMPORT_ROOT=/import
DEFAULT_FORMAT_PRIORITY=flac,alac,m4a,aac,mp3,ogg,wav
